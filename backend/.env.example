# Copier ce fichier en backend/.env puis remplir UNE des clés ci-dessous.
# backend/.env est ignoré par git : ne jamais commiter de clé.
# Avec Docker (docker compose up), ce fichier est aussi lu par le conteneur de l'API.

# --- Modèle de l'assistant (fournisseur détecté d'après la clé présente) ---
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# GEMINI_API_KEY=

# Modèle (obligatoire pour OpenRouter, facultatif ailleurs)
# HIPPO_MODEL=

# Forcer un fournisseur : anthropic | openrouter | mistral | gemini | ollama | openai_compatible
# HIPPO_LLM_PROVIDER=

# Pour openai_compatible uniquement
# HIPPO_LLM_BASE_URL=
# HIPPO_LLM_API_KEY=

# --- Recherche par le sens (embeddings) ---
# Par défaut : Gemini si GEMINI_API_KEY est défini, sinon recherche par mots-clés seule.
# HIPPO_EMBED_PROVIDER=gemini        # gemini | ollama | openai_compatible | aucun
# HIPPO_EMBED_MODEL=

# --- Base de données ---
# Sans DATABASE_URL, les décisions et données locales sont gardées dans backend/var/hippo.json.
# Avec Docker, DATABASE_URL est fourni par docker-compose.yml : ne pas le définir ici.
# Pour une API lancée hors Docker sur la base du conteneur :
# DATABASE_URL=postgresql://hippo:hippo@127.0.0.1:5433/hippo

# --- Équipe par défaut (nom affiché et repris sur la fiche HAS) ---
# HIPPO_EQUIPE_ETABLISSEMENT=CHU de démonstration
# HIPPO_EQUIPE_SERVICE=Chirurgie ambulatoire
